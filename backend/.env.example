DATABASE_URL=sqlite+aiosqlite:///./bharat3d.db
# Token signing key: a random value of at least 32 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty for local development (a random key is used per process). With ENVIRONMENT=production the API refuses
# to start without a strong key.
SECRET_KEY=
# "production" on the hosted API: strict key check, /docs /redoc /openapi.json off (override with API_DOCS=true)
ENVIRONMENT=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_MODE=true
DATA_DIR=../data
# Browser origins allowed to call the API (comma-separated; * for any)
CORS_ORIGINS=*
# Groq LLM for building names and the ward summary (optional; Faker is used when empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Set to true to skip the Hugging Face depth model even when torch/transformers are installed
REALGEN_DISABLE_ML=false
