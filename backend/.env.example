DATABASE_URL=sqlite+aiosqlite:///./bharat3d.db
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEMO_MODE=true
DATA_DIR=../data
UPLOAD_DIR=../data/uploads
# Browser origins allowed to call the API (comma-separated; * for any)
CORS_ORIGINS=*
# Groq LLM for building names and the ward summary (optional; Faker is used when empty)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Set to true to skip the Hugging Face depth model even when torch/transformers are installed
REALGEN_DISABLE_ML=false
