# Cloudflare Pages response headers.
# Rules must not overlap on Cache-Control: when two matching rules both set it, Pages sends both values joined
# together ("max-age=0, ..., max-age=31536000"), and browsers then treat the file as already stale.

# Every response: security headers. Web pages (HTML) keep Cloudflare's default caching, which re-checks them on
# every visit, so a new deployment is picked up at once.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed build files (scripts, styles and assets imported by the app): the file name changes with the content.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Satellite textures of the bundled demo areas: fixed for each area key.
/tex/*
  Cache-Control: public, max-age=31536000, immutable

# Overview poster, thumbnails and the social preview image.
/media/*
  Cache-Control: public, max-age=2592000

/bharat3d-logo.png
  Cache-Control: public, max-age=2592000
